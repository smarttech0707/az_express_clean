# ═══════════════════════════════════════════════════════════════════════════
# functions/.env.example — modèle de variables d'environnement AZ IA.
#
# Copier en `functions/.env` (jamais commité — voir .gitignore) et renseigner
# de VRAIES valeurs. Ce fichier ne contient et ne doit JAMAIS contenir de
# clé/secret réel — seulement des placeholders et des valeurs par défaut
# documentées. Aucune clé API n'est jamais exposée à Flutter : toutes celles
# ci-dessous ne sont lues que côté Cloud Functions (functions/azia/**).
# ═══════════════════════════════════════════════════════════════════════════

# ── Clés API des fournisseurs IA (chacune optionnelle indépendamment) ──────
# Un fournisseur sans sa clé est simplement traité comme "non configuré"
# (isConfigured()===false) — jamais tenté sur le réseau, jamais une panne
# fatale pour azIaChat tant que Claude (le fournisseur par défaut des tours
# à outils) reste configuré.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# ── OpenAI — configuration spécifique (toutes optionnelles, avec repli) ────
# Modèle par défaut si aucun n'est explicitement demandé par l'appelant.
OPENAI_MODEL=gpt-4o-mini
# Plafond de tokens de sortie par appel (repli si absent : 1024).
OPENAI_MAX_OUTPUT_TOKENS=1024
# Timeout réseau du SDK OpenAI, en millisecondes (repli si absent : 30000).
OPENAI_TIMEOUT_MS=30000

# 🔴 GARDE DE SÉCURITÉ CRITIQUE — NE PAS ACTIVER SANS VALIDATION E2E COMPLÈTE.
# Tant que cette variable n'est pas exactement "true", OpenAIProvider refuse
# tout tour comportant des outils (generateTurn lève provider_tools_unsupported
# plutôt que d'exécuter silencieusement un outil sans protocole éprouvé) et
# aiRouter.js retombe automatiquement sur Claude pour tout tour à outils
# même si AI_TOOL_PROVIDER=openai est configuré par erreur. La boucle
# d'outils réelle d'AZ IA (functions/azia/index.js) force de toute façon
# `forceProvider:'claude'`, indépendamment de ce flag — celui-ci protège les
# futurs appelants génériques d'AIProviderService.generateTurn(), pas
# seulement l'appelant actuel.
AI_OPENAI_TOOL_CALLING_ENABLED=false

# ── Routage (aiRouter.js) — chaque variable a un repli sûr si absente ──────
# Fournisseur par défaut pour une conversation simple, sans outil.
AI_DEFAULT_PROVIDER=claude
# Fournisseur pour une requête jugée "complexe" (turn.complexity==='complex').
AI_COMPLEX_PROVIDER=claude
# Fournisseur pour une requête avec image jointe, sans outil.
AI_IMAGE_PROVIDER=claude
# Fournisseur pour TOUT tour comportant des outils — reste 'claude' tant que
# le tool-calling OpenAI n'est pas validé de bout en bout (voir garde ci-dessus).
AI_TOOL_PROVIDER=claude
# Liste ordonnée de fournisseurs de repli, utilisée seulement si
# AI_ENABLE_FALLBACK=true ET que la requête n'a PAS d'outils (un tour à
# outils ne bascule jamais vers un fournisseur qui ne les supporte pas —
# voir AIProviderService.callWithFallback, filtre supportsTools()).
AI_FALLBACK_PROVIDERS=gemini,openai,mistral,deepseek,groq
# Liste blanche des fournisseurs autorisés par la politique (CSV).
AI_ALLOWED_PROVIDERS=claude,openai,gemini,mistral,deepseek,groq
# Active/désactive la bascule automatique en cas d'échec (défaut: false).
AI_ENABLE_FALLBACK=false
# Cache des réponses texte identiques (défaut: true) — jamais appliqué à une
# vision ni à un tour à outils (turn stateful), voir AIProviderService.js.
AI_ENABLE_CACHE=true
# Écriture des métriques ai_usage/ai_logs/ai_daily_stats (défaut: true).
AI_ENABLE_METRICS=true

# ── Coût — grille tarifaire par modèle, configurable sans redéploiement ────
# JSON optionnel {"<model-id>": {"input": <$/1M tokens>, "output": <$/1M>}}.
# Prioritaire sur le tarif par défaut par PROVIDER (codé en dur dans
# AIProviderService.js, à visée indicative) dès qu'un modèle exact y figure.
# Si absent, un modèle inconnu ET un provider inconnu font renvoyer un coût
# `null` par estimateCost() plutôt qu'un chiffre inventé.
# Exemple : AI_MODEL_PRICING={"gpt-4o":{"input":2.50,"output":10.00}}
AI_MODEL_PRICING=

# ── Déjà existant, sans rapport avec ce chantier (rappel de contexte) ──────
# FEEXPAY_TOKEN=
# FEEXPAY_WEBHOOK_SECRET=
