# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Node dependencies — never commit these (functions/node_modules is already
# tracked historically; see project memory for the cleanup this implies)
node_modules/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Sensitive Firebase / API key files — never commit these
google-services.json
GoogleService-Info.plist
lib/firebase_options.dart
.env
.env.*
functions/.env
functions/.env.*

# Release keystore — never commit private signing keys
*.keystore
*.jks
/android/key.properties

# local.properties contains SDK paths and API keys — machine-specific, never commit
/android/local.properties

# Debug symbols from obfuscated builds
/build/app/outputs/symbols/
