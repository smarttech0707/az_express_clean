rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function isAdmin() {
      return isAuth()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('isActive', true) != false;
    }
    function isOwner(userId) {
      return isAuth() && uid() == userId;
    }
    function isSuperAdmin() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', 'super') != 'sub';
    }
    function isRealUser() {
      return isAuth() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }
    function notPresent(field) {
      return !(field in request.resource.data);
    }

    // Vérifie que la session courante correspond à la pharmacie propriétaire de la commande.
    // Nécessite que pharmacies/{id}.currentUid soit sauvegardé par l'app Flutter après connexion.
    function isPharmacieOwnerOfOrder() {
      return isAuth()
        && 'pharmacieId' in resource.data
        && exists(/databases/$(database)/documents/pharmacies/$(resource.data.pharmacieId))
        && get(/databases/$(database)/documents/pharmacies/$(resource.data.pharmacieId)).data.currentUid == uid();
    }

    match /admins/{adminId} {
      allow read:  if isOwner(adminId) || isAdmin();
      // Super admin peut tout modifier (permissions, rôle, isActive…)
      // Tout admin peut mettre à jour uniquement ses propres champs OTP (2FA login)
      allow write: if isSuperAdmin()
        || (isOwner(adminId) && isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['otpHash', 'otpCode', 'otpExpiry', 'otpAttempts', 'fcmToken']));
    }

    match /clients/{clientId} {
      allow read:   if isOwner(clientId) || isAdmin();
      allow create: if isOwner(clientId);
      allow update: if isAdmin() ||
        (isOwner(clientId) && unchanged('wallet') && unchanged('fakeOrderCount') && unchanged('cashOnDeliveryEnabled')) ||
        // Débit wallet autorisé (paiement Ekbine côté client) — solde ne peut que diminuer
        (isOwner(clientId)
          && request.resource.data.wallet is int
          && request.resource.data.wallet >= 0
          && request.resource.data.wallet < resource.data.wallet
          && unchanged('fakeOrderCount') && unchanged('cashOnDeliveryEnabled'));
      allow delete: if isAdmin();
      match /wallet_transactions/{txId} {
        allow read:   if isOwner(clientId) || isAdmin();
        allow create: if isAdmin()
          || (isOwner(clientId)
            && request.resource.data.keys().hasOnly(['type','amount','description','orderId','createdAt','provider','txId'])
            && request.resource.data.amount is int);
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /livreurs/{livreurId} {
      // Lecture par tous les authentifiés (anonymes inclus pour la carte client)
      allow read:   if isAuth();
      allow create: if isAdmin();
      // Le livreur peut mettre à jour son propre doc :
      // - sans toucher au wallet (GPS, isOnline, token…)
      // - OU en diminuant son wallet (déduction commission à l'acceptation)
      allow update: if isAdmin()
        || (isOwner(livreurId) && unchanged('wallet'))
        || (isOwner(livreurId)
            && request.resource.data.wallet is int
            && request.resource.data.wallet >= 0
            && request.resource.data.wallet < resource.data.wallet);
      allow delete: if isAdmin();
      match /wallet_transactions/{txId} {
        allow read:   if isOwner(livreurId) || isAdmin();
        allow create: if isAdmin()
          || (isOwner(livreurId)
            && request.resource.data.keys().hasOnly(['type','amount','description','orderId','createdAt','provider','txId'])
            && request.resource.data.amount is int);
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /driver_requests/{requestId} {
      allow create: if isRealUser() && request.resource.data.uid == uid();
      allow read:   if isAdmin() || (isAuth() && resource.data.uid == uid());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /sellers/{sellerId} {
      allow read:   if isOwner(sellerId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isOwner(sellerId) && unchanged('wallet'));
      allow delete: if isAdmin();
      match /wallet_transactions/{txId} {
        allow read:   if isOwner(sellerId) || isAdmin();
        allow create: if isAdmin()
          || (isOwner(sellerId)
            && request.resource.data.keys().hasOnly(['type','amount','description','orderId','createdAt'])
            && request.resource.data.amount is int);
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /seller_requests/{requestId} {
      allow create: if isRealUser() && request.resource.data.uid == uid();
      allow read:   if isAdmin() || (isAuth() && resource.data.uid == uid());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /restaurants/{restaurantId} {
      allow read:  if isAuth();
      allow write: if isAdmin();

      // Sous-collection utilisée par restaurant_owner_dashboard.dart
      match /menu/{menuId} {
        allow read: if isAuth();
        allow write: if isAdmin()
          || (isRealUser()
            && get(/databases/$(database)/documents/restaurant_owners/$(request.auth.uid))
                .data.get('restaurantId', '') == restaurantId);
      }

      // Ancienne sous-collection (conservée pour compatibilité)
      match /menus/{menuId} {
        allow read:  if isAuth();
        allow write: if isAdmin();
      }
    }

    match /restaurant_owners/{ownerId} {
      allow read:  if isOwner(ownerId) || isAdmin();
      allow write: if isAdmin();
    }

    match /restaurant_requests/{requestId} {
      allow create: if isRealUser() && request.resource.data.uid == uid();
      allow read:   if isAdmin() || (isAuth() && resource.data.uid == uid());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /boulangeries/{boulangerieId} {
      allow read:   if isAuth();
      allow create: if isAdmin();
      // Le propriétaire peut mettre à jour son profil, mais pas les champs financiers
      allow update: if isAdmin() ||
        (isOwner(boulangerieId)
          && unchanged('wallet')
          && unchanged('subscriptionStatus')
          && unchanged('subscriptionExpiresAt')
          && unchanged('vipStatus')
          && unchanged('vipExpiresAt')
          && unchanged('vipStartedAt'));
      allow delete: if isAdmin();
      match /menu_items/{itemId} {
        allow read:  if isAuth();
        allow write: if isAdmin() || isOwner(boulangerieId);
      }
    }

    match /boulangerie_requests/{requestId} {
      allow create: if isRealUser() && request.resource.data.uid == uid();
      allow read:   if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /pharmacies/{pharmacieId} {
      // Le listing pharmacie (nom/adresse/horaires/garde) reste public aux
      // utilisateurs authentifiés (y compris anonymes) pour ne pas casser le
      // parcours client — ce n'est plus un risque puisque le mot de passe ne
      // vit plus ici : voir pharmacie_credentials ci-dessous, alimenté
      // uniquement par les Cloud Functions pharmacieLogin()/setPharmaciePassword().
      allow read:  if isAuth();
      // password/accessCode ne doivent plus jamais être écrits directement,
      // même par un admin — uniquement via setPharmaciePassword() (Admin SDK).
      allow write: if isAdmin()
        && !request.resource.data.keys().hasAny(['password', 'accessCode']);
      // La pharmacie peut sauvegarder son UID de session pour l'accès aux commandes.
      // Seul le champ currentUid est modifiable, et uniquement avec l'UID de la session active.
      allow update: if isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentUid'])
        && request.resource.data.currentUid == uid();
    }

    // Identifiants pharmacie hachés — écriture/lecture exclusivement via
    // pharmacieLogin()/setPharmaciePassword() (Cloud Functions, Admin SDK).
    match /pharmacie_credentials/{pharmacieId} {
      allow read, write: if false;
    }

    match /pharmacie_requests/{requestId} {
      allow create: if isRealUser() && request.resource.data.uid == uid();
      allow read:   if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /fleet_owners/{fleetId} {
      allow read:   if isOwner(fleetId) || isAdmin();
      allow create: if isRealUser() && uid() == fleetId;
      // Le propriétaire peut mettre à jour son profil, mais pas les champs financiers
      allow update: if isAdmin() ||
        (isOwner(fleetId)
          && unchanged('wallet')
          && unchanged('subscriptionStatus')
          && unchanged('subscriptionExpiresAt')
          && unchanged('vipStatus')
          && unchanged('vipExpiresAt'));
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.clientId  == uid() ||
        resource.data.driverId  == uid() ||
        resource.data.sellerId  == uid() ||
        isPharmacieOwnerOfOrder()         ||
        isAdmin()
      );
      allow create: if isRealUser()
        && request.resource.data.clientId == uid()
        && request.resource.data.budget is int
        && request.resource.data.budget >= 500
        && notPresent('driverId')
        && request.resource.data.isPaid == false
        && request.resource.data.status == 'pending';
      allow update: if isAdmin() ||
        (isAuth() && resource.data.driverId == uid()
          && unchanged('budget') && unchanged('clientId') && unchanged('isPaid')
          && unchanged('paymentMethod') && unchanged('driverId')
          && (
            (resource.data.status == 'assigned'    && request.resource.data.status == 'accepted')
            || (resource.data.status == 'accepted' && request.resource.data.status == 'picked_up')
            // À la livraison espèces : isPaid peut passer à true
            || (resource.data.status == 'picked_up' && request.resource.data.status == 'delivered'
                && (unchanged('isPaid') || request.resource.data.isPaid == true))
            || (resource.data.status == request.resource.data.status)
          )
        ) ||
        (isAuth() && resource.data.sellerId == uid()
          && unchanged('budget') && unchanged('clientId') && unchanged('isPaid')
          && unchanged('paymentMethod') && unchanged('driverId')) ||
        // Client annule sa commande en attente
        (isOwner(resource.data.clientId)
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && unchanged('budget') && unchanged('driverId') && unchanged('isPaid')) ||
        // Système côté client assigne automatiquement le livreur le plus proche
        (isOwner(resource.data.clientId)
          && resource.data.status == 'pending'
          && request.resource.data.status == 'assigned'
          && unchanged('budget') && unchanged('clientId')
          && unchanged('isPaid') && unchanged('paymentMethod')) ||
        // Client peut noter le livreur ou le vendeur après livraison
        (isOwner(resource.data.clientId)
          && resource.data.status == 'delivered'
          && unchanged('status') && unchanged('budget') && unchanged('driverId')
          && unchanged('isPaid') && unchanged('paymentMethod')
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['rating', 'sellerRating']));
      allow delete: if isAdmin();
    }

    // ── Commissions AZ Express — lecture admin uniquement ────────────────────
    match /commissions/{commissionId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /wallet_transactions/{txId} {
      allow read: if isAuth() && (resource.data.userId == uid() || resource.data.uid == uid() || isAdmin());
      // Log E-Kbine uniquement (uid doit correspondre)
      allow create: if isAuth() && request.resource.data.uid == uid();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /withdrawal_requests/{reqId} {
      allow read: if isAuth() && (resource.data.userId == uid() || isAdmin());
      allow create: if isRealUser()
        && request.resource.data.userId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is int
        && request.resource.data.amount >= 500
        && request.resource.data.amount <= 500000;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /recharge_requests/{reqId} {
      allow read: if isAuth() && (resource.data.userId == uid() || isAdmin());
      allow create: if isRealUser()
        && request.resource.data.userId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is int
        && request.resource.data.amount >= 100;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /ekbine_orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.clientId == uid() || resource.data.agentId == uid() || isAdmin()
      );
      allow create: if isRealUser()
        && request.resource.data.clientId == uid()
        && request.resource.data.status == 'pending'
        && notPresent('agentId')
        && request.resource.data.amount is int
        && request.resource.data.amount >= 100;
      allow update: if isAdmin() ||
        (isAuth() && (
          (resource.data.status == 'pending'
            && request.resource.data.status in ['assigned', 'awaiting_deposit']
            && request.resource.data.agentId == uid()
            && unchanged('clientId') && unchanged('amount') && unchanged('fee')
            && unchanged('totalPaid') && unchanged('paymentMethod')) ||
          (resource.data.status == 'assigned' && resource.data.agentId == uid()
            && request.resource.data.status == 'in_progress'
            && unchanged('clientId') && unchanged('agentId')) ||
          (resource.data.status == 'awaiting_deposit' && resource.data.agentId == uid()
            && request.resource.data.status == 'in_progress'
            && unchanged('clientId') && unchanged('agentId') && unchanged('amount')) ||
          (resource.data.status == 'in_progress' && resource.data.agentId == uid()
            && request.resource.data.status == 'proof_sent'
            && unchanged('clientId') && unchanged('agentId') && unchanged('amount'))
        )) ||
        (isAuth() && resource.data.clientId == uid() && (
          // completed : interdit en direct — passe obligatoirement par ekClientConfirmOrder (CF)
          // pour créditer le wallet agent atomiquement
          ((resource.data.status == 'pending' || resource.data.status == 'awaiting_deposit')
            && request.resource.data.status == 'cancelled'
            && unchanged('agentId') && unchanged('amount')) ||
          (resource.data.status == 'awaiting_deposit'
            && request.resource.data.status == 'awaiting_deposit'
            && unchanged('agentId') && unchanged('amount') && unchanged('agentEarning')) ||
          (resource.data.status == 'proof_sent'
            && request.resource.data.status == 'disputed'
            && unchanged('agentId') && unchanged('amount'))
        ));
      allow delete: if isAdmin();
    }

    match /ekbine_agents/{agentId} {
      allow read: if isAuth();
      allow create: if isRealUser() && uid() == agentId
        && request.resource.data.isVerified  == false
        && request.resource.data.isSuspended == false
        && request.resource.data.walletBalance  == 0
        && request.resource.data.totalCompleted == 0;
      allow update: if isAdmin() ||
        (isOwner(agentId) && unchanged('walletBalance') && unchanged('isVerified')
          && unchanged('isSuspended') && unchanged('rating') && unchanged('ratingCount')
          && unchanged('totalCompleted')) ||
        // Wallet crédité uniquement via Cloud Function ekClientConfirmOrder
        // Écriture directe depuis le client interdite pour éviter l'injection de montants arbitraires
        // Client note l'agent après service — lié à une commande completed de cet agent
        (isAuth()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['rating', 'ratingCount'])
          && request.resource.data.ratingCount == resource.data.ratingCount + 1
          && 'lastOrderId' in resource.data
          && exists(/databases/$(database)/documents/ekbine_orders/$(resource.data.lastOrderId))
          && get(/databases/$(database)/documents/ekbine_orders/$(resource.data.lastOrderId)).data.clientId == uid()
          && get(/databases/$(database)/documents/ekbine_orders/$(resource.data.lastOrderId)).data.agentId == agentId
          && get(/databases/$(database)/documents/ekbine_orders/$(resource.data.lastOrderId)).data.status == 'completed');
      allow delete: if isAdmin();
    }

    match /ekbine_chats/{orderId} {
      function ekOrderParticipant() {
        let order = get(/databases/$(database)/documents/ekbine_orders/$(orderId)).data;
        return uid() == order.clientId || uid() == order.agentId;
      }
      allow read, write: if isAdmin() || (isAuth() && ekOrderParticipant());
      match /messages/{msgId} {
        allow read:   if isAdmin() || (isAuth() && ekOrderParticipant());
        allow create: if isAuth() && ekOrderParticipant()
          && request.resource.data.senderId == uid()
          && request.resource.data.keys().hasAll(['senderId','senderRole','type'])
          && request.resource.data.type in ['text','audio'];
        allow update, delete: if isAdmin();
      }
    }

    // ── Zones de livraison géographiques ─────────────────────────────────────
    match /zones_livraison/{zoneId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    match /marketplace_products/{productId} {
      // Les produits 'hidden' ne sont visibles que par leur vendeur et les admins
      allow read: if isAdmin()
        || (isRealUser() && resource.data.sellerId == uid())
        || (isAuth() && resource.data.get('status', 'active') == 'active');
      allow create: if isRealUser()
        && request.resource.data.sellerId == uid()
        && request.resource.data.status in ['active', 'hidden']
        && request.resource.data.price is int && request.resource.data.price > 0;
      allow update: if isAdmin()
        // Propriétaire modifie son annonce (sans toucher views/favoritesCount)
        || (isRealUser() && resource.data.sellerId == uid()
          && unchanged('sellerId') && unchanged('views') && unchanged('favoritesCount'))
        // N'importe quel utilisateur peut incrémenter les vues uniquement
        || (isAuth()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']))
        // N'importe quel utilisateur peut modifier favoritesCount uniquement
        || (isAuth()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favoritesCount']));
      allow delete: if isAdmin() || (isRealUser() && resource.data.sellerId == uid());
    }

    match /marketplace_favorites/{userId} {
      allow read, write: if isOwner(userId);
      match /items/{itemId} { allow read, write: if isOwner(userId); }
    }

    match /marketplace_chats/{chatId} {
      allow read, write: if isAdmin() || (isAuth() && (
        chatId.matches('mp_[^_]+_' + uid())
        || (resource != null && resource.data.sellerId == uid())
        || (request.resource != null && request.resource.data.sellerId == uid())
      ));
      match /messages/{msgId} {
        allow read: if isAuth() && (isAdmin()
          || chatId.matches('mp_[^_]+_' + uid())
          || get(/databases/$(database)/documents/marketplace_chats/$(chatId)).data.sellerId == uid());
        allow create: if isAuth()
          && request.resource.data.senderId == uid()
          && request.resource.data.keys().hasAll(['senderId','type'])
          && request.resource.data.type in ['text','audio'];
        allow update, delete: if isAdmin();
      }
    }

    match /marketplace_reports/{reportId} {
      allow create: if isRealUser()
        && request.resource.data.reportedBy == uid()
        && request.resource.data.keys().hasAll(['productId','reportedBy','reason']);
      allow read, update, delete: if isAdmin();
    }

    // ── Immobilier (M6) — calqué sur sellers/seller_requests/marketplace_products ──
    match /real_estate_agents/{agentId} {
      allow read:   if isOwner(agentId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isOwner(agentId) && unchanged('isVerified') && unchanged('isActive'));
      allow delete: if isAdmin();
    }

    match /real_estate_agent_requests/{requestId} {
      allow create: if isRealUser() && request.resource.data.uid == uid();
      allow read:   if isAdmin() || (isAuth() && resource.data.uid == uid());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Types de biens administrables (pas de liste codée en dur, cf. dette Marketplace).
    match /real_estate_categories/{categoryId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    match /real_estate_listings/{listingId} {
      allow read: if isAdmin()
        || (isRealUser() && resource.data.agentId == uid())
        || (isAuth() && resource.data.get('status', 'active') == 'active');
      allow create: if isRealUser()
        && request.resource.data.agentId == uid()
        && request.resource.data.status in ['active', 'hidden']
        && request.resource.data.price is int && request.resource.data.price > 0;
      allow update: if isAdmin()
        || (isRealUser() && resource.data.agentId == uid()
          && unchanged('agentId') && unchanged('views'))
        || (isAuth()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']));
      allow delete: if isAdmin() || (isRealUser() && resource.data.agentId == uid());
    }

    // Demandes de visite — écriture exclusivement via requestPropertyVisit()/
    // respondToVisitRequest() (Cloud Functions), jamais depuis le client.
    match /real_estate_visit_requests/{requestId} {
      allow read: if isAdmin()
        || (isAuth() && (resource.data.clientId == uid() || resource.data.agentId == uid()));
      allow write: if false;
    }

    match /sos_alerts/{alertId} {
      allow read:   if isAdmin();
      // Le livreur envoie driverId (pas clientId)
      allow create: if isAuth()
        && request.resource.data.status == 'active'
        && (request.resource.data.keys().hasAll(['clientId','lat','lng','timestamp','status'])
          || request.resource.data.keys().hasAll(['driverId','lat','lng','timestamp','status']));
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /delivery_reports/{reportId} {
      allow read:   if isAdmin();
      allow create: if isAuth()
        && request.resource.data.driverId == uid()
        && request.resource.data.keys().hasAll(['orderId','driverId','difficulty','createdAt']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read:   if isAuth();
      // Note obligatoirement entre 1 et 5
      allow create: if isRealUser()
        && request.resource.data.keys().hasAll(['sellerId','rating','createdAt'])
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow create: if isAuth();
      allow read, write: if isAuth() && (uid() in resource.data.participants || isAdmin());
      match /messages/{messageId} {
        allow read: if isAuth() && (
          uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || isAdmin()
        );
        allow create: if isAuth()
          && uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == uid();
        allow update, delete: if isAdmin();
      }
    }

    match /boutique_orders/{orderId} {
      allow read: if isAuth() && (resource.data.clientId == uid() || isAdmin());
      allow create: if isRealUser()
        && request.resource.data.clientId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(['clientId', 'status'])
        && ('totalAmount' in request.resource.data
          ? request.resource.data.totalAmount is int && request.resource.data.totalAmount > 0
          : true);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /boutique_products/{productId} {
      allow read: if isAuth();
      allow create: if isRealUser()
        && request.resource.data.sellerId == uid();
      allow update: if isAdmin()
        || (isRealUser()
          && resource.data.sellerId == uid()
          && unchanged('sellerId'));
      allow delete: if isAdmin()
        || (isRealUser() && resource.data.sellerId == uid());
    }

    match /services/{serviceId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    match /service_providers/{providerId} {
      // LIMITATION ARCHITECTURALE : le login artisan utilise signInAnonymously() explicitement.
      // isRealUser() casserait le login. Mitigation : Phase 5 — migrer vers Cloud Function artisanLogin().
      allow read:  if isAuth();
      allow write: if isAdmin();
      allow update: if isRealUser() && !('artisanUid' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['artisanUid'])
        && request.resource.data.artisanUid == uid();
      allow update: if isRealUser() && 'artisanUid' in resource.data
        && resource.data.artisanUid == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photos']);
    }

    match /locations/{locationId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    match /residences/{residenceId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    match /blanchisserie_orders/{orderId} {
      allow read: if isAuth() && (resource.data.clientId == uid() || isAdmin());
      allow create: if isRealUser()
        && request.resource.data.clientId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(['clientId', 'status'])
        && ('totalAmount' in request.resource.data
          ? request.resource.data.totalAmount is int && request.resource.data.totalAmount > 0
          : true);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /eau_boissons_orders/{orderId} {
      allow read: if isAuth() && (resource.data.clientId == uid() || isAdmin());
      allow create: if isRealUser()
        && request.resource.data.clientId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(['clientId', 'status'])
        && ('totalAmount' in request.resource.data
          ? request.resource.data.totalAmount is int && request.resource.data.totalAmount > 0
          : true);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /clients/{clientId}/favorite_providers/{providerId} {
      allow read, write: if isOwner(clientId);
    }

    // ── Base de lieux locale AZ Express ───────────────────────────────────────
    match /places/{placeId} {
      allow read:   if isAuth();
      allow create: if isAdmin() || (isAuth()
        && request.resource.data.keys().hasAll(['name','latitude','longitude'])
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number);
      allow update: if isAdmin()
        || (isAuth() && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['searchCount', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /service_reviews/{reviewId} {
      allow read: if isAuth();
      allow create: if isRealUser()
        && request.resource.data.clientId == uid()
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.keys().hasAll(['providerId','clientId','rating','createdAt']);
      allow update, delete: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isAuth() && (resource.data.userId == uid() || isAdmin());
      allow create: if isAdmin();
      allow update: if isAuth() && resource.data.userId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt']);
      allow delete: if isAdmin() || (isAuth() && resource.data.userId == uid());
    }

    match /support_tickets/{ticketId} {
      allow read: if isAuth() && (resource.data.userId == uid() || isAdmin());
      allow create: if isRealUser()
        && request.resource.data.userId == uid()
        && request.resource.data.status == 'open';
      allow update: if isAdmin() ||
        (isOwner(resource.data.userId) && unchanged('status')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages']));
      allow delete: if isAdmin();
    }

    // ── Formulaires publics du site web marketing (Master Prompt 57) ─────────
    // Ces 3 formulaires (lib/web/pages/{contact,drivers,merchants}_page.dart)
    // sont remplis par des visiteurs anonymes du site vitrine — la connexion
    // anonyme automatique reste volontairement "mobile only" (lib/main.dart),
    // donc isAuth() y est presque toujours false. Écriture publique avec
    // validation stricte de la forme des champs, plutôt qu'un mur de connexion
    // qui n'aurait de toute façon aucune valeur anti-abus réelle (signInAnonymously()
    // est gratuit et instantané pour un attaquant).
    match /contact_messages/{msgId} {
      allow create: if request.resource.data.keys().hasAll(['email', 'message'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200;
      allow read, update, delete: if isAdmin();
    }

    // Leads "devenir livreur" — lib/web/pages/drivers_page.dart. Distinct de
    // driver_requests (inscription réelle in-app, avec compte Firebase Auth) —
    // ceci est un formulaire de contact pré-compte, suivi manuellement par
    // l'équipe (WhatsApp/appel), jamais relié à la création d'un compte livreur.
    match /driver_applications/{appId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'city', 'status'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 30
        && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // Leads "devenir partenaire" — lib/web/pages/merchants_page.dart. Même
    // distinction que ci-dessus vis-à-vis de seller_requests/restaurant_requests/etc.
    match /partner_applications/{appId} {
      allow create: if request.resource.data.keys().hasAll(['contactName', 'businessName', 'phone', 'city', 'status'])
        && request.resource.data.contactName is string && request.resource.data.contactName.size() > 0 && request.resource.data.contactName.size() <= 200
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 30
        && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // ── Config app (publique : couleurs, textes UI — pas de données financières) ─
    match /config/{configId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Config business (commissions, seuils) — réservée aux admins ─────────
    match /app_config/{configId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    match /driver_rankings/{driverId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Audit logs — écriture réservée aux Cloud Functions ────────────────────
    // Lecture restreinte au super-admin (2026-07-01) : un journal d'audit
    // complet ne doit pas être visible par tout sous-admin.
    match /audit_logs/{logId} {
      allow read:   if isSuperAdmin();
      allow write:  if false;
    }

    // ── Événements sécurité — écriture réservée aux Cloud Functions ───────────
    match /security_events/{eventId} {
      allow read:   if isAdmin();
      allow update: if isAdmin();
      allow write:  if false;
    }

    // ── Rate limits — géré par Cloud Functions uniquement ────────────────────
    match /rate_limits/{key} {
      allow read, write: if false;
    }

    // ── Journal d'observabilité par requête (Prompt 25, 2026-07-02) ─────────
    // Distinct d'audit_logs : diagnostic technique haut-volume (requestId,
    // durée, statut), pas une piste d'audit métier — voir functions/observability.js.
    // Utilisé uniquement par les nouvelles Cloud Functions, pas rétrofité.
    match /request_logs/{logId} {
      allow read:  if isSuperAdmin();
      allow write: if false;
    }

    // ── Tokens FCM invalides — nettoyage asynchrone Cloud Functions ──────────
    match /invalid_fcm_tokens/{docId} {
      allow read, write: if false;
    }

    // ── Conciliation wallet (Prompt 28, 2026-07-02) ──────────────────────────
    // Écarts détectés entre le champ `wallet` et wallet_transactions —
    // données financières sensibles, super-admin uniquement.
    match /wallet_reconciliation_findings/{findingId} {
      allow read:  if isSuperAdmin();
      allow write: if false;
    }

    // ── Métriques dispatching — écriture réservée aux Cloud Functions ─────────
    match /dispatch_metrics/{metricId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── AZ IA — historique de conversation, écriture réservée aux Cloud Functions ──
    match /ai_conversations/{ownerId} {
      allow read: if isOwner(ownerId) || isAdmin();
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isOwner(ownerId) || isAdmin();
        allow write: if false;
      }
    }

    // ── AZ IA — actions en attente de confirmation, gérées par Cloud Functions ──
    match /ai_pending_actions/{actionId} {
      allow read: if isAuth() && (resource.data.uid == uid() || isAdmin());
      allow write: if false;
    }
  }
}
