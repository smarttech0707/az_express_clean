# Modèle de functions/.env.<ID-PROJET-TEST> (le CLI Firebase charge ce fichier pour ce projet
# uniquement). Copier, renseigner, ne jamais commiter (déjà ignoré par .gitignore).
# Aucune valeur de production ici.

# SMS payants désactivés
DELIVERY_SMS_ENABLED=false
DELIVERY_SMS_PROVIDER=none
DELIVERY_PROOFS_ENABLED=true

# Paiements réels désactivés. OBLIGATOIRE : le CLI charge d'abord functions/.env (production, qui contient le
# vrai FEEXPAY_SHOP_ID) puis ce fichier ; cette ligne écrase la valeur réelle. Les retraits échouent AVANT tout débit.
FEEXPAY_SHOP_ID=DISABLED

# IA : facultatif. Ne mettre qu'une clé de TEST à plafond de dépense bas, jamais la clé de production.
# ANTHROPIC_API_KEY=
