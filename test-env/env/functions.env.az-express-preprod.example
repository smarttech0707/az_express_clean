# Modèle de functions/.env.az-express-preprod (fichier ignoré par Git). Le CLI Firebase charge functions/.env PUIS ce fichier
# pour le projet az-express-preprod uniquement ; les valeurs ci-dessous écrasent celles de functions/.env.
# AUCUN secret ici : DELIVERY_PROOF_PEPPER est un secret Firebase (firebase functions:secrets:set), jamais une ligne de ce fichier.

# Preuves de récupération et de livraison (QR/PIN) activées pour les tests du pilote.
DELIVERY_PROOFS_ENABLED=true
# Aucun SMS (le parcours QR/PIN fonctionne sans SMS externe).
DELIVERY_SMS_ENABLED=false
DELIVERY_SMS_PROVIDER=none

# Paiements réels désactivés (OBLIGATOIRE : écrase le FEEXPAY_SHOP_ID réel hérité de functions/.env).
FEEXPAY_SHOP_ID=DISABLED

# Pilote Restaurant v2 : code serveur actif, création fermée par config/partnerOrdersV2 (creationOpen=false, aucun restaurant).
PARTNER_ORDERS_V2=on
# Gel par variable : laisser ABSENT (off = gel de la gestion des commandes v2, redéploiement nécessaire).
# PARTNER_ORDERS_V2_MANAGE=off

# Plafond d'instances (functions/pilotCap.js), appliqué seulement si GCLOUD_PROJECT = az-express-preprod.
PILOT_MAX_INSTANCES=1
