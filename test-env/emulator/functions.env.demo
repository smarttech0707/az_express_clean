# Variables d'environnement des Cloud Functions dans l'émulateur (copié en .env.demo-az-express dans
# le dossier d'exécution). Aucun secret ni fournisseur réel : le .env de production n'est jamais lu.
DELIVERY_SMS_ENABLED=false
DELIVERY_SMS_PROVIDER=none
DELIVERY_PROOFS_ENABLED=true
FEEXPAY_SHOP_ID=DISABLED
AI_ENABLE_FALLBACK=false
AI_OPENAI_TOOL_CALLING_ENABLED=false
